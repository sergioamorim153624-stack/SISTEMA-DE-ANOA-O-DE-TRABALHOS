{
  "name": "nexo-servicos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "build:standalone": "vite build --mode standalone",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "npm run build && playwright test",
    "test:standalone": "npm run build:standalone && node --test tests/standalone/browser.test.js"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "vite": "^6.3.0",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
